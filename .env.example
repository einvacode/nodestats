# Salin ke .env lalu isi
ROS_HOST=192.168.88.1
ROS_PORT=443
ROS_SCHEME=https
ROS_USER=monitor
ROS_PASS=
# 1 = terima sertifikat self-signed
ROS_INSECURE=1
PORT=3000
POLL_SECONDS=10
SECRET_POLL_SECONDS=300
# Isi untuk proteksi login dashboard (basic auth)
DASH_USER=
DASH_PASS=
# DEMO=1 untuk data palsu tanpa router
DEMO=0

# --- Database & deploy ---
# Folder database SQLite (default: .\data)
# DATA_DIR=/var/lib/nodestats
# Interval simpan sample ke database (detik) dan lama retensi (hari)
SAMPLE_SECONDS=60
RETENTION_DAYS=90
# Di server Linux di belakang Apache pakai 127.0.0.1
# HOST=127.0.0.1

# Catatan: ROS_* hanya dipakai saat pertama jalan (jadi router pertama). Selanjutnya kelola router dari UI (ikon gear).
