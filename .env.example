# Salin ke .env lalu sesuaikan. (Di Linux, install.sh membuatnya otomatis.)

# --- Login dashboard (WAJIB di server; tanpa ini tombol Update nonaktif) ---
DASH_USER=
DASH_PASS=

# --- Web ---
PORT=3000
# Di belakang Apache pakai 127.0.0.1 (service systemd sudah mengaturnya)
# HOST=127.0.0.1

# --- Polling & database ---
POLL_SECONDS=10
SECRET_POLL_SECONDS=300
SAMPLE_SECONDS=60
RETENTION_DAYS=90
# Folder database SQLite (default: ./data)
# DATA_DIR=/var/lib/nodestats
# Cek update GitHub otomatis tiap N jam (0 = mati)
# UPDATE_CHECK_HOURS=6

# --- Router pertama (OPSIONAL) ---
# Hanya dibaca saat pertama kali jalan (database belum punya router).
# Cara biasa: tambahkan router dari dashboard (ikon gear), tidak perlu mengisi ini.
# ROS_HOST=192.168.88.1
# ROS_PORT=443
# ROS_SCHEME=https
# ROS_USER=monitor
# ROS_PASS=
# ROS_INSECURE=1

# --- Coba tanpa router: 1 = tambah 2 router demo (hanya jika belum ada router) ---
# DEMO=1
